# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Datadog Configuration
# Get your API & Application keys from: https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=your_datadog_api_key_here
DD_APP_KEY=your_datadog_application_key_here
DD_SITE=datadoghq.com

# AWS Credentials (for Terraform cloud provisioning)
# Configure via AWS CLI: aws configure
# Or set these environment variables:
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=eu-west-2
